# Written by Ansible (deploy/roles/app). Change the variables there, not this file.

APP_ENV=production
APP_NAME="{{ app_display_name }}"
APP_DEBUG=false
PORT={{ api_port }}
APP_URL={{ domain }}

DATABASE_URL={{ database_url }}
REDIS_URL=redis://127.0.0.1:6379/0

LOG_LEVEL=info
LOG_FORMAT=json
# supervisor collects stdout into {{ log_dir }}
LOG_OUTPUT=stdout

JWT_SECRET={{ jwt_secret }}
JWT_ACCESS_TOKEN_TTL={{ jwt_access_token_ttl }}
JWT_REFRESH_TOKEN_TTL={{ jwt_refresh_token_ttl }}

ALLOW_REGISTRATION={{ allow_registration | lower }}
AUTH_RATE_LIMIT=true
FRONTEND_URL={{ site_url }}
CORS_ALLOWED_ORIGINS={{ site_url }}
# nginx on this machine is the only proxy in front of the API
TRUSTED_PROXIES=127.0.0.1,::1

UPLOAD_FOLDER={{ uploads_dir }}
FILES_BASE_URL={{ site_url }}/api/files

# The scheduler runs as its own supervisor program, so the API must not start a second one
ENABLE_SCHEDULER=false

PULSE_USERNAME=admin
PULSE_PASSWORD={{ pulse_password | default('') }}
PULSE_PATH=/_pulse

MAIL_MAILER=smtp
MAIL_SCHEME={{ mail_scheme }}
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USERNAME={{ mail_username }}
MAIL_PASSWORD={{ mail_password | default('') }}
MAIL_FROM_ADDRESS="{{ mail_from_address }}"
MAIL_FROM_NAME="{{ mail_from_name }}"
