# API (gogo backend)
VITE_API_BASE_URL=http://localhost:8181

# App
VITE_APP_NAME=Gogo Admin
VITE_APP_VERSION=1.0.0

# Sentry error reporting. Off until VITE_SENTRY_DSN is set; read at build time.
# VITE_SENTRY_ENVIRONMENT tags events (development, production) and defaults to the Vite mode.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# E2E / Playwright
TEST_FRONTEND_PORT=5175
TEST_BACKEND_PORT=8184
VITE_E2E_API_BASE_URL=http://localhost:8184/api/v1
TEST_DATABASE_URL=postgres://postgres@localhost:5432/gogo_test?sslmode=disable
